{
  "name": "s1-pre-int-speaking-exam-app",
  "version": "2.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "wrangler dev --ip 127.0.0.1 --port 8787",
    "test": "node --test tests/*.test.cjs",
    "build": "node scripts/build-assets.cjs",
    "dev:cloudflare": "wrangler dev --ip 127.0.0.1 --port 8787",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "wrangler deploy",
    "check:deploy": "wrangler deploy --dry-run",
    "start:legacy": "node server.cjs"
  },
  "devDependencies": {
    "wrangler": "^4.141.0"
  }
}
